set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT ZIG_EXE)
  message(FATAL_ERROR "Set ZIG_EXE to a verified Zig executable")
endif()
file(TO_CMAKE_PATH "${ZIG_EXE}" ZIG_EXE)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ZIG_EXE)
set(CMAKE_C_COMPILER "${ZIG_EXE}" cc -target aarch64-linux-musl)
set(CMAKE_CXX_COMPILER "${ZIG_EXE}" c++ -target aarch64-linux-musl)
set(CMAKE_AR "${ZIG_EXE}")
set(CMAKE_C_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_ARCHIVE_FINISH "<CMAKE_AR> ranlib <TARGET>")
set(CMAKE_CXX_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_CXX_ARCHIVE_FINISH "<CMAKE_AR> ranlib <TARGET>")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
