#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
	. /lib/functions/network.sh
	config_load njupt-login
	local enabled network device client_ip key value runtime cr probe_status
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get network main network wan
	case "$network" in ''|*[!a-zA-Z0-9_]*) logger -t njupt-login 'invalid network name'; return 1;; esac
	network_flush_cache
	network_get_device device "$network" || return 0
	network_get_ipaddr client_ip "$network" || return 0
	[ -n "$device" ] && [ -n "$client_ip" ] || return 0
	umask 077
	runtime=/var/run/njupt-login
	[ ! -L "$runtime" ] || return 1
	mkdir -p "$runtime" || return 1
	chmod 700 "$runtime" || return 1
	# Atomic replacement: literal values are never evaluated by a shell.
	local tmp
	tmp=$(mktemp "$runtime/config.XXXXXX") || return 1
	cr=$(printf '\r')
	config_get probe_status main probe_status 200
	for key in username password portal_ip page_port login_port page_path interval failure_threshold retry_initial retry_max rejected_retry settle timeout connect_timeout probe_url probe_ip probe_status probe_body probe2_url probe2_ip probe2_status probe2_body; do
		[ "$key" != probe_body ] || [ "$probe_status" != 204 ] || continue
		config_get value main "$key"
		# An unset field keeps the C++ default; an explicitly empty body is written below for 204.
		[ -n "$value" ] || continue
		case "$value" in *'
'*|*"$cr"*) rm -f "$tmp"; logger -t njupt-login 'multiline config rejected'; return 1;; esac
		printf '%s=%s\n' "$key" "$value" >> "$tmp"
	done
	[ "$probe_status" != 204 ] || printf 'probe_body=\n' >> "$tmp"
	printf 'mark=20042\n' >> "$tmp"
	mv -f "$tmp" "$runtime/config" || return 1
	/usr/bin/njupt-login --config "$runtime/config" --interface "$device" --client-ip "$client_ip" --openwrt --validate >/dev/null || {
		rm -f "$runtime/config"
		logger -t njupt-login 'configuration validation failed'
		return 1
	}
	/usr/libexec/njupt-login/network setup || return 1
	procd_open_instance
	procd_set_param command /usr/bin/njupt-login --config "$runtime/config" --interface "$device" --client-ip "$client_ip" --openwrt
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 20
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/njupt-login
	procd_set_param netdev "$device"
	procd_close_instance
}

service_stopped() {
	# rc.common sends SIGTERM before this callback; cleanup can't race the next daemon refresh.
	/usr/libexec/njupt-login/network cleanup
	rm -f /var/run/njupt-login/config
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger njupt-login
}
