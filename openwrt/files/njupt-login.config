config login 'main'
	option enabled '0'
	option network 'wan'
	option username ''
	option password ''
	option portal_ip '10.10.244.11'
	option page_port '80'
	option login_port '801'
	option page_path '/a79.htm'
	option interval '60'
	option failure_threshold '3'
	option retry_initial '10'
	option retry_max '300'
	option rejected_retry '900'
	option settle '2'
	option timeout '10'
	option connect_timeout '5'
	option probe_url 'http://archive.ubuntu.com/ubuntu/'
	# IPv4 checked on 2026-10-14; maintain the pin if the endpoint changes.
	option probe_ip '91.189.92.22'
	option probe_status '200'
	option probe_body 'Index of /ubuntu'
	# For hostname URLs, set probe_ip to an actual reachable IPv4 (not a Fake-IP).
	# option probe2_url 'http://your-second-endpoint/generate_204'
	# option probe2_ip 'actual IPv4'
	# option probe2_status '204'
	# option probe2_body ''
