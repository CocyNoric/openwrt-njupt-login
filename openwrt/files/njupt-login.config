config login 'main'
	option enabled '0'
	option network 'wan'
	option username ''
	option password ''
	option portal_ip '10.10.244.11'
	option page_port '80'
	option login_port '801'
	option page_path '/a79.htm'
	option interval '15'
	option failure_threshold '3'
	option retry_initial '10'
	option retry_max '300'
	option rejected_retry '900'
	option settle '2'
	option timeout '10'
	option connect_timeout '5'
	# AliDNS first; Bilibili is only tried if this probe fails.
	option probe_url 'https://223.5.5.5/resolve?name=bilibili.com&type=A'
	option probe_ip '223.5.5.5'
	option probe_status '200'
	option probe_body '"Status":0'
	# For hostname URLs, set probe_ip to an actual reachable IPv4 (not a Fake-IP).
	option probe2_url 'https://www.bilibili.com/robots.txt'
	# IPv4 checked on 2026-10-17; maintain the pin if the endpoint changes.
	option probe2_ip '223.111.249.190'
	option probe2_status '200'
	option probe2_body 'Disallow: /medialist/detail/'
